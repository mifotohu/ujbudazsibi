# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: Optional. High-deliverability transactional email service (https://resend.com)
# When set in Vercel Environment Variables, emails are delivered via Resend directly to both customers and organizers.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Újbudazsibi <onboarding@resend.dev>"

# SENDGRID_API_KEY: Optional. SendGrid email service key fallback.
SENDGRID_API_KEY=""

# ORGANIZER_EMAIL: Notification destination email address (defaults to ujbudazsibi@gmail.com)
ORGANIZER_EMAIL="ujbudazsibi@gmail.com"

# SUPABASE: Optional. For central database synchronization across devices
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
